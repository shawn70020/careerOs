# --- Local development (Docker PostgreSQL) ---
# docker compose up -d
# Use port 5433 if Windows already has PostgreSQL on 5432 (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/careeros?schema=public"

# --- Production (Neon) — uncomment and use on Vercel ---
# DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/careeros?sslmode=require"

# Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# Production example:
# AUTH_URL="https://careeros.vercel.app"

# MVP + Public Demo use mock AI (no OpenAI cost)
AI_MODE="mock"
OPENAI_API_KEY=""
